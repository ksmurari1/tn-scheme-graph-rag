# Copy to .env and fill with your own values. Never commit .env.
NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated, verified official source URLs
SOURCE_URLS=https://www.tn.gov.in/scheme_list.php?dep_id=Mg%3D%3D
MAX_PAGES=10
